# ── تنظیمات محیطی بک‌اند ─────────────────────────────────────
# این فایل را به نام .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env

# اتصال دیتابیس PostgreSQL (اجباری)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/economy

# ── کلیدهای API (فقط برای دو منبع زیر لازم است) ──
# FRED — کلید رایگان از: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage — کلید رایگان از: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# نکته: ۱۲ منبع دیگر (World Bank, IMF, OECD, BIS, ECB, Eurostat,
# DBNOMICS, Yahoo Finance, ILO, FAO, UN, Treasury) به کلید نیاز ندارند.
